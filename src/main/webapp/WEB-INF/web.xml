<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>
  
  <context-param>
      <param-name>name</param-name>
      <param-value>menitha</param-value>
  </context-param>
  
  <context-param>
      <param-name>gf</param-name>
      <param-value>harshini</param-value>
  </context-param>
  
  <!-- Page A Mapping -->
  <servlet>
      <servlet-name>AA</servlet-name>
      <servlet-class>edu.jsp.PageA</servlet-class>
  </servlet>
  <servlet-mapping>
      <servlet-name>AA</servlet-name>
      <url-pattern>/menitha</url-pattern>
  </servlet-mapping>
  
  <!-- Page B Mapping -->
  <servlet>
      <servlet-name>BB</servlet-name>
      <servlet-class>edu.jsp.PageB</servlet-class>
      <init-param>
      <param-name>king</param-name>
      <param-value>Queen</param-value>
      </init-param>
  </servlet>
  <servlet-mapping>
      <servlet-name>BB</servlet-name>
      <url-pattern>/pinky</url-pattern>
  </servlet-mapping>
  
  <!-- Page C Mapping -->
  <servlet>
      <servlet-name>CC</servlet-name>
      <servlet-class>edu.jsp.PageC</servlet-class>
  </servlet>
  <servlet-mapping>
      <servlet-name>CC</servlet-name>
      <url-pattern>/donkey</url-pattern>
  </servlet-mapping>
  
</web-app>